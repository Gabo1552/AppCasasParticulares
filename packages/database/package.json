{
  "name": "@casas/database",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:validate": "prisma validate && prisma migrate diff --from-migrations ./prisma/migrations --to-schema-datamodel ./prisma/schema.prisma --shadow-database-url \"$SHADOW_DATABASE_URL\" --exit-code",
    "seed": "tsx prisma/seed.ts",
    "studio": "prisma studio",
    "test": "echo \"@casas/database: las pruebas de repositorio viven en apps/api (integración)\""
  },
  "dependencies": {
    "@prisma/client": "^6.1.0"
  },
  "devDependencies": {
    "@casas/config": "workspace:*",
    "@casas/domain": "workspace:*",
    "@casas/payroll-engine": "workspace:*",
    "@types/node": "^22.10.2",
    "eslint": "^10.8.0",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
