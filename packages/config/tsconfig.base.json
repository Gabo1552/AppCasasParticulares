{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],

    // `node16` en lugar del viejo `node10`: TypeScript 6 deprecó `moduleResolution: Node`
    // y dejará de aceptarlo en la 7. Los paquetes no declaran `"type": "module"`, así que
    // `module: node16` sigue emitiendo CommonJS — que es lo que NestJS espera — y las
    // importaciones relativas siguen sin necesitar extensión.
    "module": "node16",
    "moduleResolution": "node16",

    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "forceConsistentCasingInFileNames": true,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "isolatedModules": true
  }
}
