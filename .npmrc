# Resolución estricta: un paquete sólo puede importar lo que declaró.
# Es lo que hace cumplir el grafo de dependencias de docs/architecture.md §3.
node-linker=isolated
strict-peer-dependencies=false
auto-install-peers=true

# esbuild (usado por Vitest) necesita su postinstall para instalar el binario nativo.
onlyBuiltDependencies[]=esbuild
