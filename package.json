{
  "name": "casas-particulares",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "guardrails": "node scripts/guardrails.mjs",
    "db:generate": "pnpm --filter @casas/database run generate",
    "db:migrate": "pnpm --filter @casas/database run migrate",
    "db:seed": "pnpm --filter @casas/database run seed",
    "docker:up": "docker compose -f infrastructure/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infrastructure/docker/docker-compose.yml down"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@prisma/client",
      "prisma",
      "@prisma/engines",
      "@nestjs/core",
      "sharp",
      "msgpackr-extract"
    ],
    "overrides": {
      "@types/react": "19.2.18",
      "@types/react-dom": "19.2.4",
      "tar": "^7.5.22",
      "vite": "^6.4.3",
      "@xmldom/xmldom": "^0.9.8",
      "glob": "^10.5.0",
      "js-yaml": "^4.1.1",
      "postcss": "^8.5.18",
      "sharp": "^0.35.0"
    }
  }
}
