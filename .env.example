# ── Base de datos ───────────────────────────────────────────────────────────
DATABASE_URL="postgresql://casas:casas_dev_password@localhost:5432/casas?schema=public"
SHADOW_DATABASE_URL="postgresql://casas:casas_dev_password@localhost:5432/casas_shadow?schema=public"

# ── Redis (colas BullMQ, locks, idempotencia) ───────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Object storage (MinIO en desarrollo, S3-compatible en producción) ───────
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="casas-documents"
STORAGE_ACCESS_KEY="casas_dev_access"
STORAGE_SECRET_KEY="casas_dev_secret"
STORAGE_FORCE_PATH_STYLE="true"

# ── API ─────────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT="3001"
API_BASE_URL="http://localhost:3001"
WEB_BASE_URL="http://localhost:3000"
# Orígenes permitidos por CORS. Lista explícita, nunca "*".
CORS_ALLOWED_ORIGINS="http://localhost:3000"
LOG_LEVEL="debug"

# ── Secretos ────────────────────────────────────────────────────────────────
# Generá valores propios: openssl rand -base64 48
# NUNCA commitees valores reales. Estos son placeholders de desarrollo.
JWT_ACCESS_SECRET="dev-only-change-me-access-secret-value-here"
JWT_REFRESH_SECRET="dev-only-change-me-refresh-secret-value-here"
# Clave de cifrado de campos sensibles (CBU/CVU, CUIL, secreto MFA).
FIELD_ENCRYPTION_KEY="dev-only-change-me-32-bytes-key!!"
FIELD_ENCRYPTION_KEY_ID="dev-key-1"

# ── Feature flags ───────────────────────────────────────────────────────────
# Integración oficial con ARCA. Ver docs/arca-integration-strategy.md §6:
# no se enciende hasta cumplir las siete condiciones ahí listadas.
FEATURE_ARCA_OFFICIAL_CONNECTOR="false"
# Reservados. Sin código detrás en esta etapa.
FEATURE_MARKETPLACE="false"
FEATURE_REAL_PAYMENTS="false"
FEATURE_IDENTITY_VERIFICATION="false"
FEATURE_MFA_ENFORCED="false"

# ── NO EXISTE, NI DEBE EXISTIR ──────────────────────────────────────────────
# Ninguna variable de clave fiscal de ARCA. La aplicación no la solicita ni la
# almacena (SEG-06, principio 5 del encargo).
